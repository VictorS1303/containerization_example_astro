---
import Layout from "../layouts/Layout.astro"
import Section from "../components/sections/Section.astro"

import { fetchHeadingText } from "../lib/fetch_data"

const headingTextData = await fetchHeadingText()

const headingText =
  headingTextData[0].heading_text ??
  "This is a Docker containerization demonstration"
---

<Layout>
  <Section>
    <h3>{headingText}</h3>
  </Section>
</Layout>
